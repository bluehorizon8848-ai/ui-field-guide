    "e2e:i18n": "node scripts/e2e/i18n.mjs",
    "e2e:download": "node scripts/e2e/download.mjs",
    "e2e:measure": "node scripts/e2e/measure-demos.mjs",
    "e2e:crush": "node scripts/e2e/measure-crush.mjs",
