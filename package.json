    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "playwright": "^1.49.1",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
